{
  "info": {
    "name": "EduBloom API (Tasks 9-15)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order. Create an admin first: npm run create-admin, then set adminEmail/adminPassword variables. Login-limit test: repeat 'Login - wrong password' 11 times to see 429."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "serverUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "change-this-to-a-long-password"
    },
    {
      "key": "badToken",
      "value": "not.a.valid.token"
    }
  ],
